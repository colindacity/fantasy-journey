{
  "version": 2,
  "name": "fantasy-reading-guide",
  "buildCommand": "echo 'No build needed - static site'",
  "outputDirectory": "fantasy-reading-guide",
  "devCommand": "python3 -m http.server 8000",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/fantasy-reading-guide/(.*)",
      "dest": "/fantasy-reading-guide/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/fantasy-reading-guide/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fantasy-reading-guide/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
